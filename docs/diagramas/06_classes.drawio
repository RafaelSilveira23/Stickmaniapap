<mxfile host="app.diagrams.net"><diagram name="Diagrama de classes" id="06_classes"><mxGraphModel dx="1180" dy="730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="770" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="game" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Game&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- estado: str&lt;br/&gt;- pausado: bool&lt;br/&gt;- golos_azul, golos_vermelho: int&lt;br/&gt;- parte: int&lt;br/&gt;- tempo_restante: float&lt;br/&gt;- dificuldade: str&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ run()&lt;br/&gt;+ handle_events()&lt;br/&gt;+ update(dt)&lt;br/&gt;+ draw()&lt;br/&gt;+ iniciar_partida(casa, fora)&lt;br/&gt;+ assinalar_falta(infrator, vitima)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="420" y="10" width="300" height="230" as="geometry"/></mxCell><mxCell id="rink" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Rink&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- rect: Rect&lt;br/&gt;- camera: Camera&lt;br/&gt;- linha_golo_esq_x / dir_x&lt;br/&gt;- equipa_casa: str&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ draw(screen)&lt;br/&gt;+ draw_frente(screen)&lt;br/&gt;+ definir_equipa_casa(id)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="290" height="150" as="geometry"/></mxCell><mxCell id="cam" value="&lt;p style=